# Clio Manage OAuth & API Configuration
# Replace these values in your local .env.local and in your Vercel Project Settings.

# Clio Application Credentials (from Clio Developer Settings)
CLIO_CLIENT_ID=your_clio_client_id_here
CLIO_CLIENT_SECRET=your_clio_client_secret_here

# Clio OAuth Tokens
CLIO_ACCESS_TOKEN=your_clio_access_token_here
CLIO_REFRESH_TOKEN=your_clio_refresh_token_here

# Clio API Base URL
# Default: https://app.clio.com/api/v4 (US)
# Europe: https://eu.app.clio.com/api/v4
# Canada: https://ca.app.clio.com/api/v4
# Australia: https://au.app.clio.com/api/v4
CLIO_BASE_URL=https://app.clio.com/api/v4

# Allowed CORS Origin (Optional, defaults to * or set your frontend domain)
# ALLOWED_ORIGIN=https://your-resolvo-site.vercel.app
